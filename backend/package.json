{
  "name": "lonyogang-heritage-backend",
  "version": "0.5.0-dev",
  "description": "Online services backing the LonyoGang Heritage Flutter client.",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20.9.0"
  },
  "scripts": {
    "build": "tsc",
    "dev": "tsx watch src/index.ts",
    "start": "node dist/index.js",
    "migrate": "tsx src/scripts/migrate.ts",
    "migrate:reset": "tsx src/scripts/migrate.ts --reset",
    "anchor": "tsx src/scripts/anchor.ts",
    "ropa": "tsx src/scripts/ropa.ts",
    "lint": "eslint src tests",
    "test": "vitest run",
    "test:watch": "vitest",
    "verify": "pnpm lint && pnpm build && pnpm test"
  },
  "dependencies": {
    "@fastify/cors": "^9.0.1",
    "@fastify/helmet": "^11.1.1",
    "@fastify/jwt": "^8.0.1",
    "@fastify/rate-limit": "^9.1.0",
    "@fastify/sensible": "^5.6.0",
    "@simplewebauthn/server": "^10.0.0",
    "@aws-sdk/client-kms": "^3.620.0",
    "@aws-sdk/client-s3": "^3.620.0",
    "@aws-sdk/s3-request-presigner": "^3.620.0",
    "argon2": "^0.40.3",
    "nodemailer": "^6.9.14",
    "fastify": "^4.28.1",
    "jose": "^5.6.3",
    "otplib": "^12.0.1",
    "pg": "^8.12.0",
    "pino": "^9.3.1",
    "shamirs-secret-sharing": "^2.0.0",
    "ulid": "^2.3.0",
    "undici": "^6.19.2",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/node": "^20.14.2",
    "@types/nodemailer": "^6.4.15",
    "@types/pg": "^8.11.6",
    "@types/shamirs-secret-sharing": "^2.0.0",
    "@typescript-eslint/eslint-plugin": "^7.18.0",
    "@typescript-eslint/parser": "^7.18.0",
    "eslint": "^8.57.0",
    "testcontainers": "^10.10.4",
    "tsx": "^4.16.2",
    "typescript": "^5.5.3",
    "vitest": "^2.0.4"
  }
}
