# Backend configuration — copy to .env and fill in before `pnpm dev`.
NODE_ENV=development
PORT=8080
LOG_LEVEL=info

# Postgres
DATABASE_URL=postgres://lonyogang:lonyogang@localhost:55432/lonyogang

# JWT signing (Ed25519 PEM). Generate with:
#   openssl genpkey -algorithm ed25519 -outform pem
JWT_PRIVATE_KEY_PEM=
JWT_PUBLIC_KEY_PEM=
JWT_ACCESS_TTL_SECONDS=900
JWT_REFRESH_TTL_SECONDS=2592000

# Argon2id password hashing pepper — rotate annually.
PASSWORD_PEPPER=change-me-please

# WebAuthn relying party
RP_ID=localhost
RP_NAME=LonyoGang Heritage
RP_ORIGIN=http://localhost:8080

# S3-compatible object storage for attachments
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_ACCESS_KEY=lonyogang
S3_SECRET_KEY=lonyogang-secret
S3_BUCKET=lonyogang-attachments

# KMS envelope key — in production this is an HSM-managed key. For local dev
# we use a 32-byte base64-encoded value.
KMS_MASTER_KEY_B64=

# FX feed providers
FX_PROVIDER=exchangerate_host
FX_CACHE_TTL_SECONDS=1800

# Payment webhooks
FLUTTERWAVE_SECRET_HASH=
STRIPE_WEBHOOK_SECRET=

# Push notifications
FCM_PROJECT_ID=
FCM_SERVICE_ACCOUNT_JSON=
APNS_TEAM_ID=
APNS_KEY_ID=
APNS_PRIVATE_KEY_PEM=
APNS_BUNDLE_ID=com.lonyogang.heritage
